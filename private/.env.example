# Nyandior Pads Initiative - configuration template
#
# Copy this file to "private/.env" (or set the same names as real environment
# variables in your hosting control panel, which is preferred in production).
# Never commit or share the real .env file.

# --- Contact form (required) ---------------------------------------------
# Where contact form messages are delivered
CONTACT_TO_EMAIL=you@example.com
# Sender address; use an address on the website's own domain so mail isn't flagged as spoofed
CONTACT_FROM_EMAIL=info@nyandiorpads.org

# --- Rate limiting --------------------------------------------------------
# Secret used to hash IP/email addresses before storing them (required in production).
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# Rotating it is safe: it only resets the current rate-limit counters.
RATE_LIMIT_SECRET=change-me

# Where rate-limit counters are stored (must be writable, must NOT be web-accessible).
# Default: private/storage/ratelimit
# RATE_LIMIT_DIR=/home/youraccount/nyandior-ratelimit

# Limits per IP address (defaults shown)
# RATE_LIMIT_IP_SHORT_MAX=5
# RATE_LIMIT_IP_SHORT_WINDOW=600
# RATE_LIMIT_IP_DAILY_MAX=20

# Limits per sender email address (defaults shown)
# RATE_LIMIT_EMAIL_HOURLY_MAX=3
# RATE_LIMIT_EMAIL_DAILY_MAX=10

# Comma-separated IPs of your own reverse proxies / load balancers.
# Only set this if the site sits behind one (e.g. Cloudflare); otherwise leave empty
# so visitors can't fake their IP with an X-Forwarded-For header.
# TRUSTED_PROXIES=

# --- Optional --------------------------------------------------------------
# Load settings from a .env file stored somewhere else (e.g. outside the web root)
# NYANDIOR_ENV_FILE=/home/youraccount/nyandior.env
