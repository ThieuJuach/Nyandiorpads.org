# Nyandior Pads Initiative - web server security settings
# Read by Apache and LiteSpeed (Hostinger). The site is static: forms open
# WhatsApp, so nothing is ever sent to this server.

# Don't list folder contents when there's no index file
Options -Indexes

# No page accepts uploads or form posts, so reject any large request body
LimitRequestBody 10240

# Block hidden files and folders (.htaccess, .git, ...)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git(/|$)
</IfModule>

# Security headers (OWASP HTTP Headers Cheat Sheet)
<IfModule mod_headers.c>
    # Only our own files plus Google Fonts, Font Awesome (cdnjs) and the
    # Google Maps embed may load; inline scripts are blocked
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; frame-src https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Only over HTTPS: tell browsers to always use HTTPS for this site
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Hide the server version in error pages
ServerSignature Off
